# Copy to .env.local (gitignored). Never commit real values.

# Gemini key from a Google AI Studio project with NO billing account linked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Global budget per model per Pacific day, a margin under AI Studio free tier limits
# (3.5 Flash Lite and 3.1 Flash Lite: 15 RPM, 250K TPM, 50 RPD each, seen 2026-10-14).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_RPM=10
GEMINI_RPD=45

# 32 random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INSTALL_SECRET=

# Comma separated list of origins allowed to call /api/tag and /api/install.
ALLOWED_ORIGINS=http://localhost:3000

# Optional, only if Upstash Redis free tier is used for rate limit counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
